# Copy this file to .env and adjust if needed.
# The default DATABASE_URL below matches docker-compose.yml out of the box.

DATABASE_URL="postgresql://chumshow:chumshow@localhost:5432/chumshow?schema=public"

# Any random string works for local development. Generate a real one for production,
# e.g. `openssl rand -base64 32`.
AUTH_SECRET="dev-only-secret-change-in-production-0123456789abcdef"
